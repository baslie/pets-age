      "args": [
        "/c",
        "npx",
        "@upstash/context7-mcp"
      ],
      "env": {
        "CONTEXT7_API_KEY": "ctx7sk-1573e36e-c3a5-467d-b3d0-87c3961e48d0"
      }
    },
